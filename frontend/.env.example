# LIFE RPG frontend env template.
# Copy to .env.local and fill values. Never commit secrets.

# Backend base URL (Express API). Must match backend PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Auth (client-side session; backend verifies the JWT).
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev-only: bypass Supabase and act as a fixed user (backend DEV_AUTH_BYPASS must be true).
# NEVER enable in production.
NEXT_PUBLIC_DEV_BYPASS=false
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-000000000001
