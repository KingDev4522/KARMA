# KARMA frontend env template.
# Copy to .env.local and fill values. Never commit secrets.

# Backend base URL (Express API). Must match backend PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site origin used for SEO (metadataBase, canonical, sitemap, robots).
# Set to your Vercel URL in production, e.g. https://karma-xyz.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (client-side session; backend verifies the JWT).
# Google sign-in setup: Google Cloud OAuth client → Supabase Auth → Providers → Google,
# and allow-list this callback URL in Supabase (Auth → URL Configuration → Redirect URLs):
#   http://localhost:3000/auth/callback   (dev)
#   https://<your-domain>/auth/callback    (prod)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev-only: bypass Supabase and act as a fixed user (backend DEV_AUTH_BYPASS must be true).
# NEVER enable in production.
NEXT_PUBLIC_DEV_BYPASS=false
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-4000-8000-000000000001
