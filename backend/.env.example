# KARMA backend env template (required by LRP-ARCH-001 §15).
# Copy to .env and fill values. Never commit .env with secrets.

# PostgreSQL connection (Supabase or local). Prisma format.
# For Supabase pooling setups, point DATABASE_URL at the pooler and use the direct
# connection string when running `prisma migrate` (export DATABASE_URL=<direct> for that command).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_rpg?schema=public"
# Direct (non-pooled) connection for Prisma migrations. Locally same as above;
# in cloud, the Supabase direct URI (port 5432). Required by schema.prisma.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/life_rpg?schema=public"

# Supabase Auth — backend verifies Supabase JWTs, never trusts client user_id (LRP-BE-001 §4).
SUPABASE_URL="https://xyzcompany.supabase.co"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Dev-only auth bypass for local testing without Supabase (NEVER enable in production).
# When DEV_AUTH_BYPASS=true, backend accepts X-Dev-User-Id header as authenticated user.
DEV_AUTH_BYPASS=false

# Rate limiting (LRP-BE-001 §18)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MUTATION_RATE_LIMIT_MAX=30
