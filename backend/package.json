{
  "name": "life-rpg-backend",
  "version": "1.0.0",
  "description": "LIFE RPG backend — modular monolith. Server-authoritative RPG engine, PostgreSQL persistence, Supabase Auth. Per LRP-BE-001, LRP-RPG-001, LRP-ARCH-001.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/rpgEngine.test.ts && tsx tests/rewardFlow.test.ts && tsx tests/names.test.ts && tsx tests/routines.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.16.1",
    "typescript": "^5.5.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.16.2"
  },
  "engines": {
    "node": ">=20"
  }
}
